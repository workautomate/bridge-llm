# BEN REST API. Keep it on localhost unless you intentionally secure/expose it.
BEN_URL=http://127.0.0.1:8085

# BEN source checkout. setup_wsl.sh uses this default location.
BEN_ROOT=$HOME/.local/share/bridge-llm/ben

# HTTP timeout for one BEN decision. Simulations can take several seconds.
BEN_TIMEOUT=120
